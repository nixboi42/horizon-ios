+#[cfg(target_os = "ios")]
+thread_local! {
+    // None outside dispatch of a real menu touch. Synthetic focus clicks
+    // from keyboard navigation and controllers cannot request a keyboard.
+    static TEXT_FIELD_PRESS: std::cell::Cell<Option<bool>> = const { std::cell::Cell::new(None) };
+}
+
+#[cfg(target_os = "ios")]
+pub fn track_text_field_press(dispatch: impl FnOnce()) -> bool {
+    TEXT_FIELD_PRESS.set(Some(false));
+    dispatch();
+    TEXT_FIELD_PRESS.replace(None) == Some(true)
+}
+
+#[cfg(target_os = "ios")]
+pub fn record_text_field_press() {
+    if TEXT_FIELD_PRESS.get().is_some() {
+        TEXT_FIELD_PRESS.set(Some(true));
+    }
+}
