+/// iOS exposes this process's resident memory through the public Mach task API;
+/// macOS's libproc (`proc_pidinfo`) is not available in the iOS SDK.
+#[cfg(target_os = "ios")]
+pub fn resident_bytes() -> Option<u64> {
+    let mut count = libc::MACH_TASK_BASIC_INFO_COUNT;
+    // mach_task_self() is a macro for this public libSystem symbol in the
+    // Apple SDK. libc currently exposes its declaration only on macOS.
+    unsafe extern "C" {
+        static mach_task_self_: libc::mach_port_t;
+    }
+    // SAFETY: the task is our own; the zero-initialized C structure has room for
+    // exactly `count` natural_t values. task_info writes only into that buffer.
+    unsafe {
+        let mut info: libc::mach_task_basic_info = std::mem::zeroed();
+        let result = libc::task_info(
+            mach_task_self_,
+            libc::MACH_TASK_BASIC_INFO,
+            (&raw mut info).cast(),
+            &mut count,
+        );
+        (result == libc::KERN_SUCCESS && count == libc::MACH_TASK_BASIC_INFO_COUNT)
+            .then_some(info.resident_size)
+    }
+}
