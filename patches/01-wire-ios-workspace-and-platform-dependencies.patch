+        horizon_threads::ios_clipboard::get()
+            .unwrap_or_else(|| self.copied.clone().unwrap_or_default())
+    }
+    fn set(&mut self, text: &str) {
+        if !text.is_empty() {
+            self.copied = Some(text.to_owned());
+            horizon_threads::ios_clipboard::set(text);
+        }
+    }
