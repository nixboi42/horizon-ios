+// UIKit clipboard operations stay in horizon-threads, the OS boundary; this
+// crate continues to forbid unsafe code. Off-main-thread calls cannot use UIKit.
+#[cfg(target_os = "ios")]
+impl Clipboard for SystemClipboard {
