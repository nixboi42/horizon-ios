 }
 
+#[derive(Clone, Copy, Debug)]
+pub struct HotbarLayout {
+    left: i32,
+    bottom: i32,
+}
+
+impl HotbarLayout {
+    const SLOT_WIDTH: i32 = 20;
+    const WIDTH: i32 = 9 * Self::SLOT_WIDTH + 2;
+    const HEIGHT: i32 = 22;
+
+    pub fn new(width: i32, bottom: i32) -> Self {
+        Self {
+            left: width / 2 - Self::WIDTH / 2,
+            bottom,
+        }
+    }
+
+    /// The HUD is composited over the full drawable after world upscaling.
+    pub fn safe_bottom(hud: &crate::hud::HudBatch, drawable_height: u32, inset_px: f64) -> i32 {
+        if inset_px > 0.0 {
+            ((f64::from(drawable_height) - inset_px) / f64::from(hud.scale)).floor() as i32
+        } else {
+            hud.height as i32
+        }
+    }
+
+    fn slot_left(self, slot: i32) -> i32 {
+        self.left + slot * Self::SLOT_WIDTH
+    }
+
+    pub fn slot_at(self, [x, y]: [f64; 2]) -> Option<usize> {
+        let x = x - f64::from(self.left);
+        if (0.0..f64::from(Self::WIDTH)).contains(&x)
+            && (f64::from(self.bottom - Self::HEIGHT)..f64::from(self.bottom)).contains(&y)
+        {
+            // The outer pixels of the sprite belong to the first and last slots.
+            Some((((x - 1.0) / f64::from(Self::SLOT_WIDTH)).floor() as usize).min(8))
+        } else {
+            None
+        }
+    }
+}
