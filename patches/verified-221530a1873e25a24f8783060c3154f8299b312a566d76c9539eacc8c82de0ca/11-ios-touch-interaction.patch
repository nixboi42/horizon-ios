+
+    #[cfg(target_os = "ios")]
+    fn merge_touch_interaction(
+        &mut self,
+        input: &mut horizon_client::interaction_input::InteractionInput,
+        attack: bool,
+        use_item: bool,
+    ) -> (bool, bool) {
+        use horizon_client::interaction_input::Button;
+        let touch = &mut self.mobile_input;
+        let [tap_attack, tap_use] = std::mem::take(&mut touch.action_clicks);
+        let tap = touch.tap.take();
+        let mine = touch.mine;
+        let mine_started = std::mem::take(&mut touch.mine_started);
+        let [touch_attack, touch_use] = touch.action_down;
+        // Explicit buttons and physical inputs retain crosshair aim. Off-centre
+        // rays exist only inside the interaction tick, never in movement or aim.
+        if tap_attack {
+            input.press(Button::Attack);
+        }
+        if tap_use {
+            input.press(Button::Use);
+        }
+        if attack || use_item || tap_attack || tap_use || touch_attack || touch_use {
+            return (attack || touch_attack, use_item || touch_use);
+        }
+        if let Some(direction) = mine.or(tap) {
+            self.mobile_input.ray = Some(direction);
+            // A tap on an entity attacks it; a tap on a block places/uses it.
+            // The ordinary ray and reach checks enforce occlusion.
+            if mine.is_some() {
+                if mine_started {
+                    input.press(Button::Attack);
+                }
+            } else if self.pick_entity_hit().is_some() {
+                input.press(Button::Attack);
+            } else {
+                input.press(Button::Use);
+            }
+        }
+        (mine.is_some(), false)
+    }
+
+    fn touch_modifier(&self, sprint: bool) -> bool {
+        #[cfg(target_os = "ios")]
+        { self.mobile_input.modifiers[usize::from(sprint)] }
+        #[cfg(not(target_os = "ios"))]
+        { let _ = sprint; false }
     }
 
