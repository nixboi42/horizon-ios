+/// Keep policy consistent across the loader, streaming, renderer and iOS host.
+pub fn constrained_ios() -> bool {
+    #[cfg(target_os = "ios")]
+    {
+        static CONSTRAINED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *CONSTRAINED.get_or_init(|| {
+            unsafe extern "C" {
+                fn horizon_ios_constrained_memory() -> i32;
+            }
+            // SAFETY: this host function only reads process and system properties.
+            unsafe { horizon_ios_constrained_memory() != 0 }
+        })
+    }
+    #[cfg(not(target_os = "ios"))]
+    {
+        false
+    }
+}
+
+#[cfg(target_os = "ios")]
+pub fn report_footprint(stage: &str) {
+    unsafe extern "C" {
+        fn horizon_ios_footprint(current: *mut u64, peak: *mut u64);
+    }
+    let (mut current, mut peak) = (0, 0);
+    // SAFETY: both outputs point to live writable integers.
+    unsafe {
+        horizon_ios_footprint(&mut current, &mut peak);
+    }
+    eprintln!(
+        "MOBILE_MEMORY stage={stage} phys_footprint_bytes={current} lifetime_peak_bytes={peak}"
+    );
+}
