+// UIKit clipboard operations stay in horizon-threads, the OS boundary; this
+// crate continues to forbid unsafe code. Off-main-thread calls cannot use UIKit.
+#[cfg(target_os = "ios")]
+impl Clipboard for SystemClipboard {
+    fn get(&mut self) -> String {
+        horizon_threads::ios_clipboard::get()
+            .unwrap_or_else(|| self.copied.clone().unwrap_or_default())
+    }
+    fn set(&mut self, text: &str) {
+        if !text.is_empty() {
+            self.copied = Some(text.to_owned());
+            horizon_threads::ios_clipboard::set(text);
+        }
+    }
+}
